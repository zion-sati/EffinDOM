include(FetchContent)

set(CPR_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CPR_BUILD_TESTS_SSL OFF CACHE BOOL "" FORCE)
set(CPR_BUILD_TESTS_PROXY OFF CACHE BOOL "" FORCE)
set(CPR_CURL_USE_LIBPSL OFF CACHE BOOL "" FORCE)
set(CPR_ENABLE_CURL_HTTP_ONLY ON CACHE BOOL "" FORCE)
set(CPR_ENABLE_SSL ON CACHE BOOL "" FORCE)
set(CPR_USE_SYSTEM_CURL OFF CACHE BOOL "" FORCE)
set(CURL_ZLIB OFF CACHE STRING "" FORCE)
set(CURL_BROTLI OFF CACHE STRING "" FORCE)
set(CURL_ZSTD OFF CACHE STRING "" FORCE)
set(USE_NGHTTP2 OFF CACHE BOOL "" FORCE)
set(CURL_USE_LIBSSH2 OFF CACHE BOOL "" FORCE)
set(CURL_USE_LIBSSH OFF CACHE BOOL "" FORCE)
set(CURL_USE_GSSAPI OFF CACHE BOOL "" FORCE)
set(USE_LIBIDN2 OFF CACHE BOOL "" FORCE)

if(WIN32)
    set(CPR_FORCE_WINSSL_BACKEND ON CACHE BOOL "" FORCE)
elseif(APPLE)
    set(CPR_FORCE_DARWINSSL_BACKEND ON CACHE BOOL "" FORCE)
else()
    set(CPR_FORCE_OPENSSL_BACKEND ON CACHE BOOL "" FORCE)
    set(OPENSSL_USE_STATIC_LIBS ON CACHE BOOL "" FORCE)
endif()

if(DEFINED BUILD_SHARED_LIBS)
    set(_EFFINDOM_BUILD_SHARED_LIBS_WAS_DEFINED ON)
    set(_EFFINDOM_SAVED_BUILD_SHARED_LIBS "${BUILD_SHARED_LIBS}")
else()
    set(_EFFINDOM_BUILD_SHARED_LIBS_WAS_DEFINED OFF)
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
FetchContent_Declare(
    effindom_pinned_cpr
    GIT_REPOSITORY https://github.com/libcpr/cpr.git
    GIT_TAG 1.14.2
    GIT_SHALLOW TRUE
)
FetchContent_MakeAvailable(effindom_pinned_cpr)
if(_EFFINDOM_BUILD_SHARED_LIBS_WAS_DEFINED)
    set(BUILD_SHARED_LIBS "${_EFFINDOM_SAVED_BUILD_SHARED_LIBS}" CACHE BOOL "" FORCE)
else()
    unset(BUILD_SHARED_LIBS CACHE)
endif()
unset(_EFFINDOM_BUILD_SHARED_LIBS_WAS_DEFINED)
unset(_EFFINDOM_SAVED_BUILD_SHARED_LIBS)
