FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        binutils file libdbus-1-3 libfontconfig1 libvulkan1 libx11-6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

COPY validate-runtime.sh /usr/local/bin/validate-effindom-runtime
ENTRYPOINT ["/usr/local/bin/validate-effindom-runtime"]
